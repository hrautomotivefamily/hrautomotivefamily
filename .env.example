# ---------------------------------------------------------------------------
# HR Automotive — environment variables
# Copy this file to .env.local for development, and set the same variables in
# your host's dashboard (Vercel / Render) for production.
# ---------------------------------------------------------------------------

# --- Public site URL (for SEO: canonical links, sitemap, social/AI previews) -
# Set this to your real live domain once you have one, e.g.
#   NEXT_PUBLIC_SITE_URL=https://hrautomotive.co.uk
# If unset, it auto-detects Render/Vercel. Setting it explicitly is best for SEO.
NEXT_PUBLIC_SITE_URL=""

# --- Admin login (checked server-side; never sent to the browser) ----------
# Username to sign in to /admin (optional — defaults to "admin").
ADMIN_USERNAME="admin"
# Password to sign in to /admin (REQUIRED). Choose something long and private.
ADMIN_PASSWORD="change-me-to-something-long"
# Optional: a separate secret used to sign the admin session cookie.
# If omitted, ADMIN_PASSWORD is used. Set any long random string in production.
ADMIN_SESSION_SECRET=""

# --- Database (listings) ----------------------------------------------------
# Postgres connection string for saving listings in production.
# With Supabase: Project → Settings → Database → Connection string (URI).
# If left blank, listings are stored in a local file (.data/stock.json) —
# fine for development, but it will NOT persist on Vercel/Render.
DATABASE_URL=""

# --- Image storage (photo uploads) -----------------------------------------
# With Supabase: Project → Settings → API.
# SUPABASE_URL       = the Project URL
# SUPABASE_SERVICE_ROLE_KEY = the service_role secret (server-only, keep private)
# SUPABASE_BUCKET    = a public Storage bucket name (default: car-photos)
# If these are blank, uploads are written to public/uploads/ (dev only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="car-photos"
